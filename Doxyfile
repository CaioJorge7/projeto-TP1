# Doxyfile para o Trabalho Pratico 1 - Kanban (TP1)

PROJECT_NAME           = "Sistema Kanban - TP1"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Sistema de Gestao de Projetos Kanban em C++ (TP1 - Tecnicas de Programacao 1)"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Brazilian
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

# Entrada de arquivos
INPUT                  = include src main.cpp README.md README_Membro2.md README_Membro3.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = main_teste_dominios.cpp main_teste_entidades.cpp main_teste_servicos.cpp tests

# Configuracao de avisos (warnings)
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Extracao de documentacao
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

# Formatos de saida
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Configuracoes de navegacao e graficos
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
